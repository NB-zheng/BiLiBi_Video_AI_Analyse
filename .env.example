# ===== 多模态模型（OpenAI 兼容接口） =====
# 项目会调用 /chat/completions，图片以 base64 传入。
#
# DeepSeek 官方示例（deepseek-flash 支持图片，属于推理模型）：
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
#
# 其他常见服务商（按需替换）：
#   阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 AI：  https://open.bigmodel.cn/api/paas/v4
#   硅基流动： https://api.siliconflow.cn/v1
#   火山方舟： https://ark.cn-beijing.volces.com/api/v3
#   Kimi：     https://api.moonshot.cn/v1
#   OpenRouter：https://openrouter.ai/api/v1
#   本地 Ollama：http://localhost:11434/v1
#
# 注意：推理模型（如 deepseek-flash）的 reasoning_content 也会占用
# max_tokens；程序会自动翻倍重试，必要时可在命令行调高
# --segment-max-tokens / --final-max-tokens。

# ===== B站 Cookie（可选） =====
# 不填也能跑，但清晰度通常最高只有 480P。
# 也可以把完整 Cookie 保存到项目根目录的 cookie.txt。
BILI_COOKIE=

# ===== 可选配置 =====
# ffmpeg 不在 PATH 时，指定完整路径
# FFMPEG_BIN=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# PDF 中文字体（PyMuPDF 导出用；Windows 默认会自动找 simhei.ttf）
# PDF_FONT_PATH=C:\Windows\Fonts\simhei.ttf
# Edge/Chrome 路径（PDF 的 fallback 引擎用）
# EDGE_BIN=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe